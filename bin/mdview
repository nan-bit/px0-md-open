#!/bin/bash
# mdview - open a Markdown file in px0, reusing one server per workspace root,
# and shut that server down once the last browser tab closes.
#
# Usage:  mdview <file.md>
#         mdview --stop-all
#
# See README.md for design notes.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# ---- config -----------------------------------------------------------------
CONF="${MDVIEW_CONFIG:-$HOME/.config/mdview/config}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

STATE="${MDVIEW_STATE:-$HOME/.local/state/mdview}"
BROWSER="${MDVIEW_BROWSER:-Google Chrome}"
TABCOUNT="${MDVIEW_TABCOUNT:-$SELF_DIR/mdview-tabcount}"

GRACE="${MDVIEW_GRACE:-30}"   # seconds to wait for the first tab to appear
IDLE="${MDVIEW_IDLE:-10}"     # seconds with no matching tab before shutdown
POLL="${MDVIEW_POLL:-3}"      # seconds between tab checks

REG="$STATE/registry"
LOCK="$STATE/lock"

die() { echo "mdview: $*" >&2; exit 1; }

# px0 may not be on PATH: Finder's `do shell script` runs with a minimal one.
find_px0() {
  if [ -n "${PX0_BIN:-}" ] && [ -x "$PX0_BIN" ]; then printf '%s\n' "$PX0_BIN"; return 0; fi
  if command -v px0 >/dev/null 2>&1; then command -v px0; return 0; fi
  local c
  for c in "$HOME/.local/bin/px0" /opt/homebrew/bin/px0 /usr/local/bin/px0 /usr/bin/px0; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

mkdir -p "$STATE"
touch "$REG"

# ---- housekeeping shared by every invocation --------------------------------
prune() {
  # Drop rows whose px0 is gone (killed supervisor, reboot, manual kill).
  if [ -s "$REG" ]; then
    local tmp; tmp="$(mktemp)"
    while IFS=$'\t' read -r r p pid; do
      [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null \
        && printf '%s\t%s\t%s\n' "$r" "$p" "$pid" >> "$tmp"
    done < "$REG"
    mv "$tmp" "$REG"
  fi
  # Sweep logs whose px0 is no longer running.
  local f lpid
  for f in "$STATE"/px0-*.log; do
    [ -e "$f" ] || continue
    lpid="${f##*/px0-}"; lpid="${lpid%.log}"
    case "$lpid" in (*[!0-9]*) rm -f "$f"; continue;; esac
    kill -0 "$lpid" 2>/dev/null || rm -f "$f"
  done
}

case "${1:-}" in
  -h|--help)
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  --stop-all)
    prune
    n=0
    while IFS=$'\t' read -r r p pid; do
      [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null && n=$((n+1))
    done < "$REG"
    : > "$REG"
    echo "mdview: stopped $n server(s)"
    exit 0 ;;
  '') die "usage: mdview <file.md>  (--help for more)" ;;
esac

PX0="$(find_px0)" || die "px0 not found. Install it from https://px0.ai, or set PX0_BIN."
[ -x "$TABCOUNT" ] || die "helper not found or not executable: $TABCOUNT"

target="$1"
[ -e "$target" ] || die "no such file: $target"
target="$(cd "$(dirname "$target")" && pwd -P)/$(basename "$target")"

# Workspace root: the git top-level if there is one, else the file's directory.
filedir="$(dirname "$target")"
root="$(cd "$filedir" && git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$root" ] || root="$filedir"

# ---- lock so two near-simultaneous opens don't race into two servers --------
for _ in $(seq 1 50); do
  mkdir "$LOCK" 2>/dev/null && break
  sleep 0.1
done
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

prune

alive() { curl -fsS -m 1 -o /dev/null "http://127.0.0.1:$1/api/tree" 2>/dev/null; }

port=""
if [ -s "$REG" ]; then
  while IFS=$'\t' read -r r p pid; do
    [ "$r" = "$root" ] || continue
    if alive "$p"; then port="$p"; break; fi
  done < "$REG"
fi

if [ -z "$port" ]; then
  boot="$STATE/boot-$$.log"
  # -no-lsp: this is a read-only viewer, and it stops language servers such as
  # clangd from writing cache directories into the workspace.
  # -port 0: let the OS pick, so several workspaces coexist.
  "$PX0" -no-open -no-lsp -port 0 "$root" > "$boot" 2>&1 &
  pid=$!
  log="$STATE/px0-$pid.log"
  mv "$boot" "$log" 2>/dev/null || log="$boot"

  # px0 prints its chosen port on startup; wait for that line.
  for _ in $(seq 1 100); do
    port="$(grep -oE 'http://127\.0\.0\.1:[0-9]+' "$log" 2>/dev/null | head -1 | grep -oE '[0-9]+$')"
    [ -n "$port" ] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if [ -z "$port" ]; then
    echo "mdview: px0 failed to start" >&2
    cat "$log" >&2
    rm -f "$log"
    kill "$pid" 2>/dev/null
    exit 1
  fi

  tmp="$(mktemp)"
  awk -F'\t' -v r="$root" '$1 != r' "$REG" > "$tmp" 2>/dev/null
  printf '%s\t%s\t%s\n' "$root" "$port" "$pid" >> "$tmp"
  mv "$tmp" "$REG"

  # ---- supervisor: stop px0 once the last tab is gone -----------------------
  # Counts browser tabs, NOT sockets. See README "Why tabs, not sockets".
  (
    exec >>"$STATE/supervisor.log" 2>&1
    tabs() { "$TABCOUNT" "$port" 2>/dev/null || echo 0; }

    connected=0
    for _ in $(seq 1 $((GRACE * 2))); do
      kill -0 "$pid" 2>/dev/null || exit 0
      [ "$(tabs)" -gt 0 ] && { connected=1; break; }
      sleep 0.5
    done

    if [ "$connected" -eq 0 ]; then
      echo "$(date '+%F %T') no tab within ${GRACE}s, stopping px0 :$port"
      kill "$pid" 2>/dev/null
    else
      zero=0
      while kill -0 "$pid" 2>/dev/null; do
        if [ "$(tabs)" -eq 0 ]; then
          zero=$((zero + POLL))
          if [ "$zero" -ge "$IDLE" ]; then
            echo "$(date '+%F %T') idle ${IDLE}s, stopping px0 :$port ($root)"
            kill "$pid" 2>/dev/null
            break
          fi
        else
          zero=0
        fi
        sleep "$POLL"
      done
    fi

    tmp2="$(mktemp)"
    awk -F'\t' -v p="$port" '$2 != p' "$REG" > "$tmp2" 2>/dev/null
    mv "$tmp2" "$REG"
    rm -f "$log"
  ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null
fi

rmdir "$LOCK" 2>/dev/null; trap - EXIT

rel="${target#"$root"/}"
echo "mdview: $rel -> http://127.0.0.1:$port  (root: $root)"
open -a "$BROWSER" "http://127.0.0.1:$port/"
