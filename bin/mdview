#!/bin/bash
# mdview - open a Markdown file or a directory in px0, reusing one server per
# workspace root, and shut that server down once the last browser tab closes.
#
# Usage:  mdview <file.md>      root = git top-level, else the file's directory
#         mdview <directory>    root = that directory, exactly
#         mdview --stop-all
#
# See README.md for design notes.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# ---- config -----------------------------------------------------------------
CONF="${MDVIEW_CONFIG:-$HOME/.config/mdview/config}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

STATE="${MDVIEW_STATE:-$HOME/.local/state/mdview}"
BROWSER="${MDVIEW_BROWSER:-Google Chrome}"
TABCOUNT="${MDVIEW_TABCOUNT:-$SELF_DIR/mdview-tabcount}"

GRACE="${MDVIEW_GRACE:-30}"   # seconds to wait for the first tab to appear
IDLE="${MDVIEW_IDLE:-1800}"   # seconds with no matching tab before shutdown
POLL="${MDVIEW_POLL:-3}"      # seconds between tab checks

REG="$STATE/registry"
LOCK="$STATE/lock"

die() { echo "mdview: $*" >&2; exit 1; }

# Percent-encode a relative path for ?path=. LC_ALL=C so the loop walks bytes,
# not characters, which is what keeps a UTF-8 name correct; the mask undoes
# bash's sign extension of bytes above 0x7F.
urlenc() {
  local LC_ALL=C s="$1" o="" c n i
  for (( i=0; i<${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9._~/-]) o+="$c" ;;
      *) printf -v n '%d' "'$c"; printf -v c '%%%02X' "$(( n & 0xFF ))"; o+="$c" ;;
    esac
  done
  printf '%s' "$o"
}

# px0 may not be on PATH: Finder's `do shell script` runs with a minimal one.
find_px0() {
  if [ -n "${PX0_BIN:-}" ] && [ -x "$PX0_BIN" ]; then printf '%s\n' "$PX0_BIN"; return 0; fi
  if command -v px0 >/dev/null 2>&1; then command -v px0; return 0; fi
  local c
  for c in "$HOME/.local/bin/px0" /opt/homebrew/bin/px0 /usr/local/bin/px0 /usr/bin/px0; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

mkdir -p "$STATE"
touch "$REG"

# The registry is rewritten read-modify-write from two places -- here and the
# supervisor, when its px0 dies -- so both must serialise on the same lock.
# Without it a supervisor can write back a copy it read just before a
# concurrent open appended its row, and that row is lost: a live px0 nothing
# will ever stop. Giving up after ~10s is deliberate; a stale lock directory
# should not wedge the tool for good.
lock_acquire() {
  local i
  for i in $(seq 1 100); do
    mkdir "$LOCK" 2>/dev/null && return 0
    sleep 0.1
  done
  return 1
}
lock_release() { rmdir "$LOCK" 2>/dev/null; }

# ---- housekeeping shared by every invocation --------------------------------
prune() {
  # Drop rows whose px0 is gone (killed supervisor, reboot, manual kill).
  if [ -s "$REG" ]; then
    local tmp; tmp="$(mktemp)"
    while IFS=$'\t' read -r r p pid; do
      [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null \
        && printf '%s\t%s\t%s\n' "$r" "$p" "$pid" >> "$tmp"
    done < "$REG"
    mv "$tmp" "$REG"
  fi
  # Sweep logs whose px0 is no longer running.
  local f lpid
  for f in "$STATE"/px0-*.log; do
    [ -e "$f" ] || continue
    lpid="${f##*/px0-}"; lpid="${lpid%.log}"
    case "$lpid" in (*[!0-9]*) rm -f "$f"; continue;; esac
    kill -0 "$lpid" 2>/dev/null || rm -f "$f"
  done
}

case "${1:-}" in
  -h|--help)
    sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  --stop-all)
    prune
    n=0
    while IFS=$'\t' read -r r p pid; do
      [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null && n=$((n+1))
    done < "$REG"
    : > "$REG"
    echo "mdview: stopped $n server(s)"
    exit 0 ;;
  '') die "usage: mdview <file.md|directory>  (--help for more)" ;;
esac

PX0="$(find_px0)" || die "px0 not found. Install it from https://px0.ai, or set PX0_BIN."
[ -x "$TABCOUNT" ] || die "helper not found or not executable: $TABCOUNT"

target="$1"
# Finder hands a folder over as "/path/to/dir/"; the trailing slash would make
# dirname/basename read it as its own parent.
while :; do
  case "$target" in
    /) break ;;
    */) target="${target%/}" ;;
    *) break ;;
  esac
done
[ -e "$target" ] || die "no such file or directory: $target"

# Workspace root. A directory is taken at its word -- if you point at
# ~/repo/docs you get docs/, not the whole repo, even though git would climb.
# A file has no such intent to honour, so it climbs to the git top-level.
if [ -d "$target" ]; then
  target="$(cd "$target" && pwd -P)"
  root="$target"
else
  target="$(cd "$(dirname "$target")" && pwd -P)/$(basename "$target")"
  filedir="$(dirname "$target")"
  root="$(cd "$filedir" && git rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$root" ] || root="$filedir"
fi

# ---- lock so two near-simultaneous opens don't race into two servers --------
lock_acquire || true
trap 'lock_release' EXIT

prune

alive() { curl -fsS -m 1 -o /dev/null "http://127.0.0.1:$1/api/tree" 2>/dev/null; }

# Prefer a server on exactly this root; failing that, the deepest one whose
# root already contains it. Open ~/notes, then open a file inside it, and you
# land back in the workspace that is already up instead of starting a second
# px0 underneath it -- which is the whole point of browsing from the tab.
port=""
up=""; upport=""
if [ -s "$REG" ]; then
  while IFS=$'\t' read -r r p pid; do
    [ -n "${r:-}" ] || continue
    if [ "$r" = "$root" ]; then
      alive "$p" && { port="$p"; break; }
      continue
    fi
    case "$root" in
      "$r"/*)
        [ "${#r}" -gt "${#up}" ] || continue
        alive "$p" && { up="$r"; upport="$p"; }
        ;;
    esac
  done < "$REG"
fi
if [ -z "$port" ] && [ -n "$up" ]; then
  port="$upport"
  root="$up"
fi

if [ -z "$port" ]; then
  boot="$STATE/boot-$$.log"
  # -no-lsp: this is a read-only viewer, and it stops language servers such as
  # clangd from writing cache directories into the workspace.
  # -port 0: let the OS pick, so several workspaces coexist.
  #
  # The next two only exist in newer px0, and an unknown flag is fatal, so ask
  # --help rather than assume. -no-agent matters: since 0.1.7 px0 offers to
  # edit files through a coding harness, which is not what "double-click to
  # read this" should hand you.
  flags=(-no-open -no-lsp -port 0)
  px0_help="$("$PX0" --help 2>&1)"
  case "$px0_help" in *-no-agent*) flags+=(-no-agent) ;; esac
  case "$px0_help" in *-no-telemetry*) flags+=(-no-telemetry) ;; esac
  "$PX0" "${flags[@]}" "$root" > "$boot" 2>&1 &
  pid=$!
  log="$STATE/px0-$pid.log"
  mv "$boot" "$log" 2>/dev/null || log="$boot"

  # px0 prints its chosen port on startup; wait for that line.
  for _ in $(seq 1 100); do
    port="$(grep -oE 'http://127\.0\.0\.1:[0-9]+' "$log" 2>/dev/null | head -1 | grep -oE '[0-9]+$')"
    [ -n "$port" ] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if [ -z "$port" ]; then
    echo "mdview: px0 failed to start" >&2
    cat "$log" >&2
    rm -f "$log"
    kill "$pid" 2>/dev/null
    exit 1
  fi

  tmp="$(mktemp)"
  awk -F'\t' -v r="$root" '$1 != r' "$REG" > "$tmp" 2>/dev/null
  printf '%s\t%s\t%s\n' "$root" "$port" "$pid" >> "$tmp"
  mv "$tmp" "$REG"

  # ---- supervisor: stop px0 once the last tab is gone -----------------------
  # Counts browser tabs, NOT sockets. See README "Why tabs, not sockets".
  (
    exec >>"$STATE/supervisor.log" 2>&1
    tabs() { "$TABCOUNT" "$port" 2>/dev/null || echo 0; }

    connected=0
    for _ in $(seq 1 $((GRACE * 2))); do
      kill -0 "$pid" 2>/dev/null || exit 0
      [ "$(tabs)" -gt 0 ] && { connected=1; break; }
      sleep 0.5
    done

    if [ "$connected" -eq 0 ]; then
      echo "$(date '+%F %T') no tab within ${GRACE}s, stopping px0 :$port"
      kill "$pid" 2>/dev/null
    else
      zero=0
      while kill -0 "$pid" 2>/dev/null; do
        if [ "$(tabs)" -eq 0 ]; then
          zero=$((zero + POLL))
          if [ "$zero" -ge "$IDLE" ]; then
            echo "$(date '+%F %T') idle ${IDLE}s, stopping px0 :$port ($root)"
            kill "$pid" 2>/dev/null
            break
          fi
        else
          zero=0
        fi
        sleep "$POLL"
      done
    fi

    lock_acquire || true
    tmp2="$(mktemp)"
    awk -F'\t' -v p="$port" '$2 != p' "$REG" > "$tmp2" 2>/dev/null
    mv "$tmp2" "$REG"
    lock_release
    rm -f "$log"
  ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null
fi

lock_release; trap - EXIT

# px0 0.1.7 reads ?path= on load: it opens that file and reveals it in the
# sidebar, then strips the parameter from the URL. Older px0 ignores it and
# shows the workspace root, which is the behaviour this tool used to have.
url="http://127.0.0.1:$port/"
if [ "$target" = "$root" ]; then
  echo "mdview: $root -> $url"
else
  rel="${target#"$root"/}"
  url="$url?path=$(urlenc "$rel")"
  echo "mdview: $rel -> $url"
fi
open -a "$BROWSER" "$url"
